# StudioSpace Client Environment Variables

# Backend API Base URL
# - In local development: http://localhost:5000
# - In production (cross-domain): https://studiospace-server.onrender.com
# - In production (same-site BFF proxy): Leave empty ("") to route through Next.js /api rewrites
NEXT_PUBLIC_API_URL=http://localhost:5000

# Next.js BFF Proxy Destination (used by next.config.mjs rewrites when proxying /api/*)
BACKEND_API_URL=http://localhost:5000

# Client Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional ImgBB API Key for direct cloud photo uploads (get free key at https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=
